{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiverse.dev/schemas/multiple-bots/coordination-v1.schema.json",
  "title": "AI-Verse Multiple Bots Coordination Protocol v1",
  "description": "Draft normalized contracts for Bots, Rooms, Messages, Tasks, Artifacts, Team Runs and Events.",
  "oneOf": [
    { "$ref": "#/$defs/Bot" },
    { "$ref": "#/$defs/Room" },
    { "$ref": "#/$defs/Message" },
    { "$ref": "#/$defs/Task" },
    { "$ref": "#/$defs/Artifact" },
    { "$ref": "#/$defs/TeamRun" },
    { "$ref": "#/$defs/Event" }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "WorkspaceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["workspace", "operator"]
        },
        "workspace_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "workspace" } }
          },
          "then": {
            "required": ["workspace_id"]
          }
        }
      ]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["origin", "trusted_instruction"],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "canonical_os",
            "operator_input",
            "bot_generated",
            "worker_generated",
            "external_web",
            "external_document",
            "external_message",
            "remote_agent",
            "runtime_tool"
          ]
        },
        "trusted_instruction": {
          "type": "boolean"
        },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        }
      }
    },
    "ContentPart": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "artifact_ref",
            "file_ref",
            "image_ref",
            "audio_ref",
            "video_ref",
            "structured_data",
            "citation_ref",
            "tool_receipt_ref"
          ]
        },
        "text": { "type": "string" },
        "ref": { "$ref": "#/$defs/Id" },
        "data": {}
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_limit": { "type": ["integer", "null"], "minimum": 0 },
        "cost_limit": { "type": ["number", "null"], "minimum": 0 },
        "wall_clock_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "max_workers": { "type": ["integer", "null"], "minimum": 1 },
        "max_hops": { "type": ["integer", "null"], "minimum": 0 },
        "max_messages": { "type": ["integer", "null"], "minimum": 1 },
        "max_rounds": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "Bot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "name", "kind", "status", "runtime", "scope", "permissions"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "const": "durable" },
        "status": {
          "type": "string",
          "enum": ["active", "disabled", "archived"]
        },
        "description": { "type": ["string", "null"] },
        "runtime": {
          "type": "object",
          "additionalProperties": true,
          "required": ["adapter"],
          "properties": {
            "adapter": { "type": "string", "minLength": 1 },
            "profile_ref": { "type": ["string", "null"] }
          }
        },
        "model_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "role_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
            "skill_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
            "operator_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
            "tool_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": true,
          "required": ["policy_ref"],
          "properties": {
            "policy_ref": { "$ref": "#/$defs/Id" },
            "allowed_peers": { "type": "array", "items": { "type": "string" } },
            "can_create_workers": { "type": "boolean" },
            "can_create_bots": { "type": "boolean" },
            "can_handoff": { "type": "boolean" }
          }
        },
        "coordination": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Room": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "name", "status", "scope", "members", "orchestration"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "scope": { "$ref": "#/$defs/WorkspaceScope" },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "orchestration": {
          "type": "object",
          "additionalProperties": true,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["conversational", "manager", "review", "hybrid"]
            },
            "speaker_policy": { "type": "string" },
            "leader": { "type": ["string", "null"] },
            "max_rounds_per_user_turn": { "type": "integer", "minimum": 1 },
            "max_bot_messages_per_user_turn": { "type": "integer", "minimum": 1 },
            "allow_member_mentions": { "type": "boolean" },
            "allow_user_escalation": { "type": "boolean" }
          }
        },
        "budget": { "$ref": "#/$defs/Budget" }
      }
    },
    "MessageTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["bot", "worker", "room", "task", "operator"]
        },
        "id": { "$ref": "#/$defs/Id" }
      }
    },
    "Message": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "timestamp", "sender_id", "target", "workspace_id", "content", "provenance"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "message.chat" },
        "timestamp": { "$ref": "#/$defs/Timestamp" },
        "sender_id": { "$ref": "#/$defs/Id" },
        "target": { "$ref": "#/$defs/MessageTarget" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "correlation_id": { "$ref": "#/$defs/Id" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContentPart" },
          "minItems": 1
        },
        "mentions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "id",
        "type",
        "created_by",
        "assignee_id",
        "workspace_id",
        "root_objective_id",
        "reason",
        "objective",
        "required_constraints",
        "expected_output",
        "lease_id",
        "hop",
        "max_hops",
        "status"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "task.delegate" },
        "created_by": { "$ref": "#/$defs/Id" },
        "assignee_id": { "$ref": "#/$defs/Id" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "run_id": { "$ref": "#/$defs/Id" },
        "root_objective_id": { "$ref": "#/$defs/Id" },
        "parent_task_id": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "required_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints_digest": { "type": ["string", "null"] },
        "expected_output": {
          "type": "object",
          "additionalProperties": true,
          "minProperties": 1
        },
        "input_artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "lease_id": { "$ref": "#/$defs/Id" },
        "hop": { "type": "integer", "minimum": 0 },
        "max_hops": { "type": "integer", "minimum": 0 },
        "budget": { "$ref": "#/$defs/Budget" },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "assigned",
            "accepted",
            "running",
            "waiting_input",
            "waiting_approval",
            "blocked",
            "completed",
            "failed",
            "canceled",
            "timeout",
            "budget_exhausted",
            "rejected_policy"
          ]
        }
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "workspace_id", "created_by", "kind", "version", "provenance"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "artifact" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "created_by": { "$ref": "#/$defs/Id" },
        "run_id": { "$ref": "#/$defs/Id" },
        "task_id": { "$ref": "#/$defs/Id" },
        "media_type": { "type": ["string", "null"] },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "content_ref": { "type": ["string", "null"] },
        "digest": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    },
    "TeamRun": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "workspace_id", "root_objective_id", "topology", "status"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "team_run" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "root_objective_id": { "$ref": "#/$defs/Id" },
        "leader_id": { "type": ["string", "null"] },
        "topology": {
          "type": "string",
          "enum": [
            "single",
            "manager",
            "handoff",
            "parallel_panel",
            "group_room",
            "pipeline",
            "review",
            "dynamic_squad",
            "hybrid"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "planning",
            "running",
            "waiting_input",
            "waiting_approval",
            "synthesizing",
            "verifying",
            "completed",
            "failed",
            "canceled",
            "budget_exhausted"
          ]
        },
        "budget": { "$ref": "#/$defs/Budget" }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "timestamp", "actor_id"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "type": "string", "minLength": 1 },
        "timestamp": { "$ref": "#/$defs/Timestamp" },
        "actor_id": { "$ref": "#/$defs/Id" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "run_id": { "$ref": "#/$defs/Id" },
        "task_id": { "$ref": "#/$defs/Id" },
        "room_id": { "$ref": "#/$defs/Id" },
        "correlation_id": { "$ref": "#/$defs/Id" },
        "causation_id": { "$ref": "#/$defs/Id" },
        "trace_id": { "$ref": "#/$defs/Id" },
        "summary": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    }
  }
}