{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aiverse-filmmakers/AI-Verse-Multiple-Bots/schemas/coordination-v1.schema.json",
  "title": "AI-Verse Multiple Bots Coordination Protocol v1",
  "description": "Architecture-stage normalized contracts aligned with Coordination Protocol v1.1 for persistent Bots, temporary Workers, Rooms, Threads, Messages, Tasks, Handoffs, Artifacts, Team Runs, leases, approvals and coordination Events.",
  "oneOf": [
    { "$ref": "#/$defs/Bot" },
    { "$ref": "#/$defs/Worker" },
    { "$ref": "#/$defs/Room" },
    { "$ref": "#/$defs/Thread" },
    { "$ref": "#/$defs/Message" },
    { "$ref": "#/$defs/Task" },
    { "$ref": "#/$defs/Handoff" },
    { "$ref": "#/$defs/Artifact" },
    { "$ref": "#/$defs/TeamRun" },
    { "$ref": "#/$defs/CapabilityLease" },
    { "$ref": "#/$defs/EnvironmentLease" },
    { "$ref": "#/$defs/Approval" },
    { "$ref": "#/$defs/Event" }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "WorkspaceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["workspace", "operator"]
        },
        "workspace_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "workspace" } }
          },
          "then": {
            "required": ["workspace_id"]
          }
        }
      ]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["origin", "trusted_instruction"],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "canonical_os",
            "operator_input",
            "bot_generated",
            "worker_generated",
            "external_web",
            "external_document",
            "external_message",
            "remote_agent",
            "runtime_tool"
          ]
        },
        "trusted_instruction": {
          "type": "boolean"
        },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        }
      }
    },
    "ContentPart": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "artifact_ref",
            "file_ref",
            "image_ref",
            "audio_ref",
            "video_ref",
            "structured_data",
            "citation_ref",
            "tool_receipt_ref"
          ]
        },
        "text": { "type": "string" },
        "ref": { "$ref": "#/$defs/Id" },
        "data": {}
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_limit": { "type": ["integer", "null"], "minimum": 0 },
        "cost_limit": { "type": ["number", "null"], "minimum": 0 },
        "wall_clock_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "max_workers": { "type": ["integer", "null"], "minimum": 1 },
        "max_hops": { "type": ["integer", "null"], "minimum": 0 },
        "max_messages": { "type": ["integer", "null"], "minimum": 1 },
        "max_rounds": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "Execution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["environment_policy"],
      "properties": {
        "environment_policy": {
          "type": "string",
          "enum": ["shared_workspace", "isolated_bot", "isolated_run", "external_managed"]
        },
        "environment_ref": { "type": ["string", "null"] },
        "persistence": {
          "type": "string",
          "enum": ["durable", "run_scoped", "disposable", "external"]
        },
        "computer_use": {
          "type": ["string", "boolean", "null"]
        },
        "browser_session_policy": {
          "type": ["string", "null"]
        }
      }
    },
    "AttentionState": {
      "type": "string",
      "enum": [
        "none",
        "working",
        "unread_result",
        "needs_input",
        "needs_approval",
        "handoff_waiting",
        "failed"
      ]
    },
    "Bot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "name", "kind", "status", "role", "runtime", "execution", "scope", "permissions", "coordination"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "const": "durable" },
        "status": {
          "type": "string",
          "enum": ["active", "disabled", "archived"]
        },
        "role": {
          "type": "object",
          "additionalProperties": true,
          "required": ["title", "mission"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "mission": { "type": "string", "minLength": 1 },
            "responsibilities": { "type": "array", "items": { "type": "string" } },
            "non_responsibilities": { "type": "array", "items": { "type": "string" } }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": true,
          "required": ["adapter"],
          "properties": {
            "adapter": { "type": "string", "minLength": 1 },
            "profile_ref": { "type": ["string", "null"] }
          }
        },
        "execution": { "$ref": "#/$defs/Execution" },
        "model_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "scope": { "$ref": "#/$defs/WorkspaceScope" },
        "capabilities": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "role_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
            "skill_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
            "operator_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
            "tool_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": true,
          "required": ["policy_ref"],
          "properties": {
            "policy_ref": { "$ref": "#/$defs/Id" },
            "allowed_peers": { "type": "array", "items": { "type": "string" } },
            "can_create_workers": { "type": "boolean" },
            "can_create_bots": { "type": "boolean" },
            "can_handoff": { "type": "boolean" }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": true
        },
        "coordination": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "manager_id": { "type": ["string", "null"] },
            "default_mode": { "type": "string" },
            "max_parallel_workers": { "type": "integer", "minimum": 1 },
            "max_hops": { "type": "integer", "minimum": 0 }
          }
        },
        "attention": {
          "type": "object",
          "additionalProperties": true
        },
        "ui": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Worker": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "run_id", "created_by", "workspace_id", "role", "status"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "worker" },
        "run_id": { "$ref": "#/$defs/Id" },
        "task_id": { "type": ["string", "null"] },
        "created_by": { "$ref": "#/$defs/Id" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "role": {
          "type": "object",
          "additionalProperties": true,
          "required": ["title", "objective"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "objective": { "type": "string", "minLength": 1 }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": true
        },
        "execution": { "$ref": "#/$defs/Execution" },
        "capability_lease_id": { "type": ["string", "null"] },
        "environment_lease_id": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": ["created", "ready", "running", "waiting", "completed", "failed", "canceled", "expired"]
        }
      }
    },
    "Room": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "name", "status", "scope", "members", "orchestration"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "scope": { "$ref": "#/$defs/WorkspaceScope" },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "orchestration": {
          "type": "object",
          "additionalProperties": true,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["conversational", "manager", "review", "hybrid"]
            },
            "speaker_policy": { "type": "string" },
            "leader": { "type": ["string", "null"] },
            "work_owner_policy": {
              "type": "string",
              "enum": ["explicit_single_owner", "leader_owned", "task_owned"]
            },
            "max_rounds_per_user_turn": { "type": "integer", "minimum": 1 },
            "max_bot_messages_per_user_turn": { "type": "integer", "minimum": 1 },
            "allow_member_mentions": { "type": "boolean" },
            "allow_user_escalation": { "type": "boolean" }
          }
        },
        "threads": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "inherit_room_scope": { "type": "boolean" }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        },
        "attention": {
          "type": "object",
          "additionalProperties": true
        },
        "budget": { "$ref": "#/$defs/Budget" }
      }
    },
    "Thread": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "workspace_id", "parent_message_id", "created_by", "status"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "thread" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "room_id": { "type": ["string", "null"] },
        "bot_conversation_id": { "type": ["string", "null"] },
        "parent_message_id": { "$ref": "#/$defs/Id" },
        "created_by": { "$ref": "#/$defs/Id" },
        "status": { "type": "string", "enum": ["active", "resolved", "archived"] }
      }
    },
    "MessageTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["bot", "worker", "room", "thread", "task", "operator"]
        },
        "id": { "$ref": "#/$defs/Id" }
      }
    },
    "Message": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "timestamp", "sender_id", "target", "workspace_id", "content", "provenance"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "message.chat" },
        "timestamp": { "$ref": "#/$defs/Timestamp" },
        "sender_id": { "$ref": "#/$defs/Id" },
        "target": { "$ref": "#/$defs/MessageTarget" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "thread_id": { "type": ["string", "null"] },
        "reply_to_message_id": { "type": ["string", "null"] },
        "correlation_id": { "type": ["string", "null"] },
        "delivery_state": {
          "type": "string",
          "enum": ["queued", "accepted", "delivered", "processing", "replied", "expired", "failed", "canceled"]
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContentPart" },
          "minItems": 1
        },
        "mentions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "id",
        "type",
        "created_by",
        "assignee_id",
        "owner_id",
        "workspace_id",
        "root_objective_id",
        "reason",
        "objective",
        "required_constraints",
        "expected_output",
        "lease_id",
        "hop",
        "max_hops",
        "status"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "task.delegate" },
        "created_by": { "$ref": "#/$defs/Id" },
        "assignee_id": { "$ref": "#/$defs/Id" },
        "owner_id": { "$ref": "#/$defs/Id" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "run_id": { "type": ["string", "null"] },
        "root_objective_id": { "$ref": "#/$defs/Id" },
        "parent_task_id": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "required_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints_digest": { "type": ["string", "null"] },
        "expected_output": {
          "type": "object",
          "additionalProperties": true,
          "minProperties": 1
        },
        "input_artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "lease_id": { "$ref": "#/$defs/Id" },
        "environment_lease_id": { "type": ["string", "null"] },
        "hop": { "type": "integer", "minimum": 0 },
        "max_hops": { "type": "integer", "minimum": 0 },
        "budget": { "$ref": "#/$defs/Budget" },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "assigned",
            "accepted",
            "running",
            "waiting_input",
            "waiting_approval",
            "blocked",
            "completed",
            "failed",
            "canceled",
            "timeout",
            "budget_exhausted",
            "rejected_policy"
          ]
        }
      }
    },
    "Handoff": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "id",
        "type",
        "source_owner_id",
        "target_bot_id",
        "workspace_id",
        "root_objective_id",
        "reason",
        "required_constraints",
        "return_policy",
        "status"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "handoff" },
        "source_owner_id": { "$ref": "#/$defs/Id" },
        "target_bot_id": { "$ref": "#/$defs/Id" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "task_id": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "root_objective_id": { "$ref": "#/$defs/Id" },
        "reason": { "type": "string", "minLength": 1 },
        "required_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "context_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "capability_lease_id": { "type": ["string", "null"] },
        "environment_lease_id": { "type": ["string", "null"] },
        "return_policy": {
          "type": "string",
          "enum": ["stay_with_target", "return_on_completion", "return_on_block", "explicit_only"]
        },
        "status": {
          "type": "string",
          "enum": ["requested", "accepted", "rejected", "ownership_changed", "completed", "canceled", "failed"]
        }
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "workspace_id", "created_by", "kind", "version", "provenance"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "artifact" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "created_by": { "$ref": "#/$defs/Id" },
        "run_id": { "type": ["string", "null"] },
        "task_id": { "type": ["string", "null"] },
        "media_type": { "type": ["string", "null"] },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "content_ref": { "type": ["string", "null"] },
        "digest": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    },
    "TeamRun": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "workspace_id", "root_objective_id", "topology", "status"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "team_run" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "root_objective_id": { "$ref": "#/$defs/Id" },
        "leader_id": { "type": ["string", "null"] },
        "participant_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "topology": {
          "type": "string",
          "enum": [
            "single",
            "manager",
            "handoff",
            "parallel_panel",
            "group_room",
            "pipeline",
            "review",
            "dynamic_squad",
            "hybrid"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "planning",
            "running",
            "waiting_input",
            "waiting_approval",
            "synthesizing",
            "verifying",
            "completed",
            "failed",
            "canceled",
            "budget_exhausted"
          ]
        },
        "budget": { "$ref": "#/$defs/Budget" }
      }
    },
    "CapabilityLease": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "principal", "issued_to", "workspace_id", "task_id", "expires_at"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "capability_lease" },
        "principal": { "$ref": "#/$defs/Id" },
        "issued_to": { "$ref": "#/$defs/Id" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "task_id": { "$ref": "#/$defs/Id" },
        "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "connections": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "destructive_actions": { "type": "string", "enum": ["deny", "approval_required", "allow_by_policy"] },
        "expires_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "EnvironmentLease": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "issued_to", "workspace_id", "environment_policy", "environment_ref", "expires_at"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "environment_lease" },
        "issued_to": { "$ref": "#/$defs/Id" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "task_id": { "type": ["string", "null"] },
        "environment_policy": {
          "type": "string",
          "enum": ["shared_workspace", "isolated_bot", "isolated_run", "external_managed"]
        },
        "environment_ref": { "$ref": "#/$defs/Id" },
        "expires_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Approval": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "workspace_id", "actor_id", "status", "action"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "approval" },
        "workspace_id": { "$ref": "#/$defs/Id" },
        "actor_id": { "$ref": "#/$defs/Id" },
        "task_id": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["pending", "approved", "denied", "expired", "canceled"] },
        "action": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "summary"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "type", "timestamp", "actor_id"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "type": "string", "minLength": 1 },
        "timestamp": { "$ref": "#/$defs/Timestamp" },
        "actor_id": { "$ref": "#/$defs/Id" },
        "workspace_id": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "task_id": { "type": ["string", "null"] },
        "room_id": { "type": ["string", "null"] },
        "thread_id": { "type": ["string", "null"] },
        "room_sequence": { "type": ["integer", "null"], "minimum": 0 },
        "correlation_id": { "type": ["string", "null"] },
        "causation_id": { "type": ["string", "null"] },
        "trace_id": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "attention_state": { "$ref": "#/$defs/AttentionState" },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    }
  }
}